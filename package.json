{
  "name": "vhl-text-overlay",
  "version": "0.2.1",
  "private": true,
  "description": "Chrome extension: type temporary text on the VHL Central textbook reader.",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "check": "node scripts/release.mjs check",
    "build": "node scripts/release.mjs build",
    "notes": "node scripts/release.mjs notes",
    "release": "node scripts/release.mjs prepare",
    "screenshots": "node scripts/screenshots.mjs",
    "test:mutations": "node scripts/mutation-check.mjs",
    "icons": "node scripts/icons.mjs",
    "store-assets": "node scripts/store-assets.mjs"
  },
  "devDependencies": {
    "lucide-static": "0.460.0",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
